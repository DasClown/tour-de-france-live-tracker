# TDF Live Tracker — Beispiel-Konfiguration
#
# Kopiere diese Datei nach .env und passe die Werte an.
# .env wird von .gitignore ignoriert — deine Secrets bleiben lokal.

# Auth-Token für /api/* und /ws. Leer = keine Auth (nur localhost!).
# Generiere ein starkes Token mit:  openssl rand -hex 24
TDF_TOKEN=

# Pfad für den JSONL-Trail (Live-Snapshots). Leer = kein Trail.
TDF_JSONL_PATH=/var/lib/tdf-tracker/live.jsonl

# systemd-Dienstname, den /api/control steuert.
TDF_SERVICE_NAME=tdf-tracker
